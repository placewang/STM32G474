".\sd_usb\shell_ext.o"
".\sd_usb\log.o"
".\sd_usb\dev_led.o"
--library_type=microlib --strict --scatter ".\SD_USB\SD_USB.sct"
--keep=shellCommand* --summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "SD_USB.map" -o .\SD_USB\SD_USB.axf