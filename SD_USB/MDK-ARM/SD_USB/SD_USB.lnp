--cpu=Cortex-M4.fp.sp
".\sd_usb\startup_stm32f407xx.o"
".\sd_usb\main.o"
".\sd_usb\gpio.o"
".\sd_usb\dma.o"
".\sd_usb\usart.o"
".\sd_usb\stm32f4xx_it.o"
".\sd_usb\stm32f4xx_hal_msp.o"
".\sd_usb\stm32f4xx_hal_uart.o"
".\sd_usb\stm32f4xx_hal_rcc.o"
".\sd_usb\stm32f4xx_hal_rcc_ex.o"
".\sd_usb\stm32f4xx_hal_flash.o"
".\sd_usb\stm32f4xx_hal_flash_ex.o"
".\sd_usb\stm32f4xx_hal_flash_ramfunc.o"
".\sd_usb\stm32f4xx_hal_gpio.o"
".\sd_usb\stm32f4xx_hal_dma_ex.o"
".\sd_usb\stm32f4xx_hal_dma.o"
".\sd_usb\stm32f4xx_hal_pwr.o"
".\sd_usb\stm32f4xx_hal_pwr_ex.o"
".\sd_usb\stm32f4xx_hal_cortex.o"
".\sd_usb\stm32f4xx_hal.o"
".\sd_usb\stm32f4xx_hal_exti.o"
".\sd_usb\system_stm32f4xx.o"
".\sd_usb\platform_init.o"
".\sd_usb\platform_uart.o"
".\sd_usb\board.o"
".\sd_usb\initcall.o"
".\sd_usb\uart_board.o"
".\sd_usb\uart_callback.o"
